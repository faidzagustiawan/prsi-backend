# =============================================================================
# PodorukunSI backend
# Semua nilai di sini HARUS berbeda dari PodorukunTrack.
# Untuk produksi lihat .env.production.example
# =============================================================================

NODE_ENV=development
PORT=3100
HOST=127.0.0.1
FRONTEND_URL=http://localhost:5174
# true = izinkan semua origin CORS (masa uji). Kembalikan false setelah origin frontend pasti.
CORS_ALLOW_ALL=false
API_URL=http://localhost:3100

# Runtime API -> role si_app (lewat transaction pooler boleh)
DATABASE_URL=postgresql://si_app:PASSWORD@HOST/neondb?sslmode=require
# Query laporan -> role si_report. Kosong = pakai DATABASE_URL.
REPORT_DATABASE_URL=
# Advisory lock worker -> session pooler / koneksi langsung. Kosong = pakai DATABASE_URL.
SESSION_DATABASE_URL=
DB_POOL_MAX=5
# Migrasi (drizzle-kit) -> role si_migrator. Jangan dipakai oleh aplikasi.
SI_MIGRATOR_DATABASE_URL=postgresql://si_migrator:PASSWORD@HOST/neondb?sslmode=require

# Minimal 32 karakter, JANGAN sama dengan JWT_SECRET / COOKIE_SECRET Track.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=

# Redis: semua key SI otomatis diberi prefix "si:". Opsional di development.
REDIS_URL=redis://localhost:6379

# Hanya untuk development dengan Postgres lokal tanpa role si_*.
# Server menolak start kalau role DB bisa menyentuh schema public, kecuali flag ini
# true DAN NODE_ENV=development.
ALLOW_UNSAFE_DB_ROLE=false

# Sinkronisasi PR Track. Worker: npm run worker
# SYNC_ENABLED=false mematikan semua koneksi ke Track (saklar bila Track dicurigai dibobol).
SYNC_ENABLED=false
# Fase pilot: hanya Track -> SI; true baru setelah jalur PUT disetujui
SYNC_WRITE_ENABLED=false
# Wajib https di produksi. Dev dengan server tiruan: http://127.0.0.1:3900 (npm run mock:track)
TRACK_API_URL=
# Token baca-saja untuk GET /sync/v1/*, dan token khusus untuk PUT jadwal/kunci pembayaran
TRACK_SYNC_TOKEN=
# Boleh kosong selama SYNC_WRITE_ENABLED=false
TRACK_SCHEDULE_TOKEN=
SYNC_INTERVAL_SEC=120
# v2 = cursor urutan commit (docs/TrackSyncAPI.md 3.1). v1 hanya untuk Track yang belum dimigrasi.
SYNC_PROTOCOL=v1
# Selama masih ada event, putaran berikutnya dipercepat ke interval ini
SYNC_BUSY_INTERVAL_SEC=10
# v2: peringatan bila event tertahan transaksi Track yang terbuka lebih lama dari ini
SYNC_HELD_WARN_SEC=300
SYNC_RECONCILE_HOUR=2
