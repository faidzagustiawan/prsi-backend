# =============================================================================
# PodorukunSI backend
# Semua nilai di sini HARUS berbeda dari PodorukunTrack.
# Lihat docs/DatabaseIsolation.md
# =============================================================================

NODE_ENV=development
PORT=3100
HOST=127.0.0.1
FRONTEND_URL=http://localhost:5174
API_URL=http://localhost:3100

# Runtime backend -> role si_app (tidak punya akses tabel Track)
DATABASE_URL=postgresql://si_app:PASSWORD@HOST/neondb?sslmode=require
# Query laporan -> role si_report di read replica Neon. Kosong = pakai DATABASE_URL.
REPORT_DATABASE_URL=
# Migrasi (drizzle-kit) -> role si_migrator. Jangan dipakai oleh aplikasi.
SI_MIGRATOR_DATABASE_URL=postgresql://si_migrator:PASSWORD@HOST/neondb?sslmode=require

# Minimal 32 karakter, JANGAN sama dengan JWT_SECRET / COOKIE_SECRET Track.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=

# Redis boleh dipakai bersama Track; semua key SI otomatis diberi prefix "si:".
REDIS_URL=redis://localhost:6379

# Hanya untuk development dengan Postgres lokal tanpa role si_*.
# Server menolak start kalau role DB bisa menyentuh schema public, kecuali flag ini
# true DAN NODE_ENV=development.
ALLOW_UNSAFE_DB_ROLE=false
