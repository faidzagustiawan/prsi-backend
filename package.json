{
  "name": "podorukun-si-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "docs:build": "node scripts/build-api-docs.js",
    "docs:serve": "node scripts/serve-api-docs.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "vitest run",
    "lint": "eslint src scripts",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/check-migrations.js",
    "db:migrate": "node scripts/check-migrations.js && drizzle-kit migrate",
    "user:create": "node scripts/create-user.js",
    "seed:dev": "node scripts/seed-dev.js",
    "worker": "node src/worker.js",
    "mock:track": "node scripts/mock-track.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/redis": "^7.2.0",
    "@fastify/swagger": "^9.7.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "^10.0.1",
    "@scalar/api-reference": "1.72.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "vitest": "^3.2.6"
  }
}
