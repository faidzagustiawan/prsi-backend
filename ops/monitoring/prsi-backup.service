[Unit]
Description=PRSI daily finance and attachment backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/bin/bash /opt/prsi-backup/backup-daily.sh
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
PrivateTmp=true
