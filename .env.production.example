# =============================================================================
# PodorukunSI backend - PRODUKSI (VPS SI)
# Salin menjadi .env di server, lalu isi. Jangan commit file .env.
# Semua nilai di sini HARUS berbeda dari PodorukunTrack.
# =============================================================================

NODE_ENV=production
PORT=3100
# Loopback: nginx di depan yang memegang 80/443
HOST=127.0.0.1
# Domain frontend SI (boleh lebih dari satu, pisahkan koma)
FRONTEND_URL=https://si.podorukun.example
API_URL=https://api-si.podorukun.example

# -----------------------------------------------------------------------------
# Database (Postgres di Sumopod)
#
# Sebelumnya, jalankan sekali sebagai user owner/admin Sumopod:
#   psql "<URL owner, koneksi langsung>" \
#     -v si_migrator_password='...' -v si_app_password='...' -v si_report_password='...' \
#     -f database/setup/001_roles_and_schema.sql
# Script itu membuat role si_migrator, si_app, si_report dan schema finance.
# Pakai password yang sama di URL di bawah.
#
# Di pooler, username kadang perlu format khusus (mis. si_app.<id-database>).
# Ikuti format yang ditampilkan Sumopod untuk masing-masing jenis koneksi.
# Bila Sumopod mewajibkan SSL, akhiri URL dengan ?sslmode=require
# -----------------------------------------------------------------------------

# 1. API, role si_app -> TRANSACTION POOLER
DATABASE_URL=postgresql://si_app:PASSWORD_SI_APP@HOST_TRANSACTION_POOLER:PORT/NAMA_DB?sslmode=require

# 2. Laporan, role si_report -> TRANSACTION POOLER (kosong = pakai DATABASE_URL)
REPORT_DATABASE_URL=postgresql://si_report:PASSWORD_SI_REPORT@HOST_TRANSACTION_POOLER:PORT/NAMA_DB?sslmode=require

# 3. Lock worker sinkronisasi, role si_app -> SESSION POOLER (atau DIRECT)
#    Jangan transaction pooler: advisory lock harus tetap di satu koneksi.
SESSION_DATABASE_URL=postgresql://si_app:PASSWORD_SI_APP@HOST_SESSION_POOLER:PORT/NAMA_DB?sslmode=require

# 4. Migrasi (npm run db:migrate), role si_migrator -> DIRECT CONNECTION
#    (session pooler juga bisa bila direct tidak tersedia). Tidak dipakai aplikasi.
SI_MIGRATOR_DATABASE_URL=postgresql://si_migrator:PASSWORD_SI_MIGRATOR@HOST_DIRECT:PORT/NAMA_DB?sslmode=require

# Ukuran pool API per proses. Jumlahkan dengan pool proses lain (worker) dan
# sesuaikan dengan batas koneksi paket Sumopod.
DB_POOL_MAX=5

# -----------------------------------------------------------------------------
# Secret (minimal 32 karakter, JWT_SECRET != COOKIE_SECRET, beda dari Track)
# Buat dengan: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_SECRET=
COOKIE_SECRET=

# Redis wajib di produksi (rate limit, throttle login). Key SI berprefix si:
REDIS_URL=redis://127.0.0.1:6379

# Folder berkas lampiran. Arahkan ke disk yang di-backup.
UPLOAD_DIR=/var/lib/podorukun-si/lampiran

# -----------------------------------------------------------------------------
# Sinkronisasi PR Track (npm run worker)
# SYNC_ENABLED=false memutus semua koneksi ke Track (saklar darurat).
# Biarkan false sampai API /sync/v1 di Track siap (docs/TrackSyncAPI.md).
# -----------------------------------------------------------------------------
SYNC_ENABLED=false
# Fase pilot wajib false agar SI tidak mengirim PUT ke PR Track
SYNC_WRITE_ENABLED=false
# Wajib https
TRACK_API_URL=https://api-track.podorukun.example
# Token baca-saja (GET /sync/v1/*) dan token khusus jadwal (PUT), dari tim Track
TRACK_SYNC_TOKEN=
# Kosongkan selama fase pilot read-only
TRACK_SCHEDULE_TOKEN=
SYNC_INTERVAL_SEC=120
SYNC_RECONCILE_HOUR=2

# Jangan diubah di produksi
ALLOW_UNSAFE_DB_ROLE=false
